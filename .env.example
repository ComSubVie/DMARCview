# ===========================================================================
# DMARCView configuration
# Copy to .env and edit. Only the Core section is mandatory for a local run.
# ===========================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# production | development
APP_ENV=production

# Signs the session cookie. Generate with: openssl rand -base64 36
SECRET_KEY=replace-me-with-32-plus-random-characters

ADMIN_USERNAME=admin

# Choose ONE credential form:
# 1) Plain password (simple, acceptable for local use):
ADMIN_PASSWORD=replace-me
# 2) PBKDF2 hash (preferred, keeps the password out of the environment):
#    python -m app.cli hash-password
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$...

# Set true when the dashboard is served over HTTPS. If you open it on
# http://localhost, leave false or the login cookie will not stick.
COOKIE_SECURE=false

# Session lifetime in seconds (default: 14 days).
SESSION_MAX_AGE=1209600

# ---------------------------------------------------------------------------
# Data directory
# ---------------------------------------------------------------------------
# Where SQLite, raw reports and archives live. The Docker image uses /data.
# DATA_DIR=/data
# DATABASE_URL=sqlite:////data/dmarc.db

# ---------------------------------------------------------------------------
# JMAP — report ingestion and optional email submission
# ---------------------------------------------------------------------------
# JMAP is used to poll the report mailbox. The same credentials are used for
# JMAP email submission when EMAIL_TRANSPORT selects it below.
JMAP_ENABLED=true
JMAP_URL=https://mail.example.com
JMAP_USERNAME=dmarc@example.com
JMAP_PASSWORD=replace-me

# Bearer token instead of basic auth (recommended for mail automation).
# JMAP_TOKEN=

# Sender address for JMAP email submission. Falls back to SMTP_FROM, then to
# the account's first submission identity.
JMAP_FROM=

# Folder that receives aggregate reports (matched by name, case-insensitive).
JMAP_MAILBOX=DMARC

# Poll interval in seconds (minimum 30).
JMAP_POLL_SECONDS=300

# How far back the very first sync looks.
INGEST_INITIAL_DAYS=90

# ---------------------------------------------------------------------------
# Alert evaluation
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_INTERVAL_MINUTES=60

# Suppress repeated notifications for the same finding within this window.
ALERT_COOLDOWN_MINUTES=60

# Public URL used for links in notifications (optional).
ALERT_BASE_URL=

# ---------------------------------------------------------------------------
# Email delivery (alerts and weekly digest)
# ---------------------------------------------------------------------------
# auto  = SMTP when fully configured, otherwise JMAP; retry through JMAP if
#         SMTP fails.
# smtp  = force SMTP.
# jmap  = force Stalwart JMAP EmailSubmission.
EMAIL_TRANSPORT=auto

# Comma-separated recipients for incident alerts. Also used by the digest when
# DIGEST_TO is empty.
ALERT_TO=

# SMTP submission. Leave blank when using JMAP only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dmarc@example.com

# ---------------------------------------------------------------------------
# Weekly digest
# ---------------------------------------------------------------------------
DIGEST_ENABLED=false
# Comma-separated recipients; falls back to ALERT_TO.
DIGEST_TO=
# Digest window and minimum interval between sends.
DIGEST_DAYS=7

# ---------------------------------------------------------------------------
# Other alert channels
# ---------------------------------------------------------------------------
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signal via a signal-cli-rest-api sidecar
SIGNAL_API_URL=
SIGNAL_NUMBER=
SIGNAL_RECIPIENTS=

# Generic webhook (JSON body, optional HMAC signature)
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Health checks and background jobs
# ---------------------------------------------------------------------------
# Comma-separated resolvers; leave empty for the system resolver. Use a
# validating resolver if you want DNSSEC to show as validated.
DNS_NAMESERVERS=

HEALTH_CHECKS_ENABLED=true
HEALTH_INTERVAL_MINUTES=360
PROBE_INTERVAL_MINUTES=360

# Expected outbound EHLO/HELO FQDN. Only used by the DNS readiness check;
# it does not configure Stalwart. Set the same name Stalwart sends.
HELO_HOSTNAME=

# Probes need outbound TCP to 25 (MX) and any extra targets you configure.
PROBE_TIMEOUT_SECONDS=8
HTTP_TIMEOUT_SECONDS=6

# Reverse DNS + forward-confirmed rDNS for sending IPs in reports.
PTR_ENRICHMENT_ENABLED=true

# Delay before the first scheduled run after boot.
JOBS_INITIAL_DELAY_SECONDS=25

# ---------------------------------------------------------------------------
# GeoIP and analytics
# ---------------------------------------------------------------------------
# Optional country/ASN lookup. Drop DB-IP Lite or MaxMind .mmdb files into
# data/geoip/ or point these at the files.
# GEOIP_DB=/data/geoip/dbip-country-lite.mmdb
# GEOIP_ASN_DB=/data/geoip/dbip-asn-lite.mmdb

# Thin progress-bar target on the dashboard.
MONTHLY_MESSAGE_ALERT=10000

# ---------------------------------------------------------------------------
# Storage, retention and backups
# ---------------------------------------------------------------------------
# Local snapshots kept by `python -m app.cli backup`.
BACKUP_KEEP=14

# Archive raw payloads, then delete reports older than this. 0 = keep forever.
RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Advanced server options
# ---------------------------------------------------------------------------
# Set when the app is served under a path prefix (e.g. /dmarc).
# ROOT_PATH=/dmarc

# Override the built SPA location (normally frontend/dist).
# FRONTEND_DIST=/app/frontend/dist
