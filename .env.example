# ---------------------------------------------------------------------------
# DMARCView configuration — copy to .env and edit.
# ---------------------------------------------------------------------------

# production | development
APP_ENV=production

# Signs the session cookie. Generate one with: openssl rand -base64 36
SECRET_KEY=replace-me-with-32-plus-random-characters

ADMIN_USERNAME=admin

# One of the two credential options below is required.
# 1) Plain password (simple, fine for local use):
ADMIN_PASSWORD=replace-me
# 2) PBKDF2 hash (preferred — keeps the password out of the environment):
#    python -m app.cli hash-password
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$...

# Set to true when the dashboard is served over HTTPS. If you open the app on
# http://localhost, leave this false or the login cookie will not stick.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# JMAP ingestion (Stalwart)
# ---------------------------------------------------------------------------
JMAP_ENABLED=true
JMAP_URL=https://mail.example.com
JMAP_USERNAME=dmarc@example.com
JMAP_PASSWORD=replace-me
# Bearer token instead of basic auth (optional):
# JMAP_TOKEN=
# Mailbox that receives the aggregate reports (matched by name, case-insensitive):
JMAP_MAILBOX=DMARC
# Poll interval in seconds (minimum 30):
JMAP_POLL_SECONDS=300
# How far back the very first sync looks:
INGEST_INITIAL_DAYS=90

# ---------------------------------------------------------------------------
# Domain health, probes and background jobs
# ---------------------------------------------------------------------------
# Comma-separated resolvers; leave empty for the system resolver.
# Use a validating resolver if you want DNSSEC to show as validated.
DNS_NAMESERVERS=
HEALTH_CHECKS_ENABLED=true
HEALTH_INTERVAL_MINUTES=360
PROBE_INTERVAL_MINUTES=360
# Probes need outbound TCP to 25 (MX) and any extra targets you configure.
PROBE_TIMEOUT_SECONDS=8
HTTP_TIMEOUT_SECONDS=6
PTR_ENRICHMENT_ENABLED=true
# Delay before the first scheduled run after boot.
JOBS_INITIAL_DELAY_SECONDS=25

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_INTERVAL_MINUTES=60
# Suppress repeat notifications for the same finding within this window.
ALERT_COOLDOWN_MINUTES=60
# Public URL used in notification links (optional).
ALERT_BASE_URL=

# Email (SMTP submission; starttls | ssl | none)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dmarc@example.com
# Comma-separated recipients.
ALERT_TO=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signal via a signal-cli-rest-api sidecar
SIGNAL_API_URL=
SIGNAL_NUMBER=
SIGNAL_RECIPIENTS=

# Generic webhook (JSON body, optional HMAC signature)
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------
# Thin progress bar alert threshold on the dashboard.
MONTHLY_MESSAGE_ALERT=10000

# Local backup snapshots kept by `python -m app.cli backup`.
BACKUP_KEEP=14

# Country lookups for sending IPs. Drop a MaxMind GeoLite2 or DB-IP Lite
# .mmdb into data/geoip/ (or point this at the file). Optional.
# GEOIP_DB=/data/geoip/dbip-country-lite.mmdb

# Where the SQLite database and raw reports live (non-Docker default: ./data).
# DATA_DIR=/data
# DATABASE_URL=sqlite:////data/dmarc.db
